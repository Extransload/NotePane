{
  "name": "notepane",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop note pane app with tabbed sessions and sticky windows.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:app": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "install:browsers": "playwright install chromium",
    "icons": "node scripts/build-icons.mjs",
    "build": "vite build",
    "start": "npm run build && node scripts/run-app.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e:renderer": "playwright test tests/e2e/renderer.spec.mjs --fully-parallel --workers=4",
    "test:e2e:electron": "playwright test tests/e2e/electron.spec.mjs --workers=1",
    "test:e2e": "npm run test:e2e:renderer && npm run test:e2e:electron",
    "verify:quick": "npm run check:refs && npm run build && npm run test:unit && node scripts/verify-dist.mjs",
    "verify": "npm run check:refs && npm run build && npm run test:unit && node scripts/verify-dist.mjs && npm run test:e2e",
    "app": "npm run build && electron-builder --config electron-builder.yml",
    "app:mac": "npm run build && electron-builder --mac zip --config electron-builder.yml",
    "app:win": "npm run build && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "@blocknote/code-block": "0.52.1",
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@floating-ui/react": "0.27.20",
    "@mantine/core": "9.4.2",
    "@mantine/hooks": "9.4.2",
    "lucide-react": "^1.27.0",
    "prettier": "3.9.6",
    "prosemirror-tables": "1.8.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "6.0.4",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "vite": "8.1.5"
  }
}
