{
  "name": "notepane",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first desktop note pane app with tabbed sessions and sticky windows.",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:app": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "install:browsers": "playwright install chromium",
    "icons": "node scripts/build-icons.mjs",
    "dmg-background": "node scripts/build-dmg-background.mjs",
    "build": "vite build",
    "start": "npm run build && node scripts/run-app.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e:renderer": "playwright test tests/e2e/renderer --fully-parallel --workers=4",
    "test:e2e:electron": "playwright test tests/e2e/electron.spec.mjs --workers=1",
    "test:e2e": "npm run test:e2e:renderer && npm run test:e2e:electron",
    "verify:quick": "npm run check:refs && npm run check:colors && npm run build && npm run test:unit && node scripts/verify-dist.mjs",
    "verify": "npm run check:refs && npm run check:colors && npm run build && npm run test:unit && node scripts/verify-dist.mjs && npm run test:e2e",
    "app": "npm run build && electron-builder --config electron-builder.config.cjs",
    "app:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "app:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "release:publish": "npm run build && electron-builder --config electron-builder.config.cjs --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@blocknote/code-block": "0.52.1",
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@emoji-mart/data": "^1.2.1",
    "@floating-ui/react": "0.27.20",
    "@mantine/core": "9.4.2",
    "@mantine/hooks": "9.4.2",
    "@playwright/test": "^1.61.1",
    "@prettier/plugin-php": "0.26.0",
    "@prettier/plugin-xml": "3.4.2",
    "@scalar/ruby-fmt": "0.7.1",
    "@scalar/rust-fmt": "0.3.0",
    "@scalar/swift-fmt": "0.3.0",
    "@shikijs/themes": "4.3.1",
    "@vitejs/plugin-react": "6.0.4",
    "@wasm-fmt/clang-format": "23.1.1",
    "@wasm-fmt/lua_fmt": "0.3.3",
    "@wasm-fmt/ruff_fmt": "0.15.20",
    "@wasm-fmt/shfmt": "0.2.7",
    "cross-env": "^10.1.0",
    "electron": "43.8.4",
    "electron-builder": "26.15.3",
    "katex": "0.19.1",
    "lucide-react": "^1.27.0",
    "prettier": "3.9.6",
    "prettier-plugin-glsl": "0.3.1",
    "prettier-plugin-svelte": "4.1.1",
    "prosemirror-tables": "1.8.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass-formatter": "0.8.0",
    "sql-formatter": "15.9.0",
    "tex-fmt": "0.5.7-npm.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-bold": "3.32.1",
    "@tiptap/extension-bubble-menu": "3.32.1",
    "@tiptap/extension-code": "3.32.1",
    "@tiptap/extension-floating-menu": "3.32.1",
    "@tiptap/extension-italic": "3.32.1",
    "@tiptap/extension-strike": "3.32.1",
    "@tiptap/extension-text": "3.32.1",
    "@tiptap/extension-underline": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1"
  }
}
